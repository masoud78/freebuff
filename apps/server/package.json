{
  "name": "@freebuff/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/core/database/database.test.ts src/services/settings.test.ts src/services/phase5.test.ts src/services/phase6.test.ts src/services/phase7.test.ts src/services/phase8.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/core/database/migrate.ts",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@freebuff/contracts": "workspace:*",
    "@google/genai": "^2.17.1",
    "@libsql/client": "^0.17.4",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.12.0",
    "pino": "^10.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0"
  }
}
